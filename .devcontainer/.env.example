# Copy this file to .devcontainer/.env. The copy is intentionally ignored.

# Directory containing the host's Quartus installation.
# Example:
# RV32_QUARTUS_HOST_ROOT=/home/your-user/altera/std25.1
RV32_QUARTUS_HOST_ROOT=/absolute/path/to/altera/std25.1

# Optional: pin a container image tag or digest for strict reproducibility.
RV32_DEV_IMAGE=ghcr.io/insper-riscv/dev_tools:latest

