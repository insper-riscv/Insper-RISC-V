  "sdk_tracked_diff": "diff --git a/.github/workflows/sdk.yml b/.github/workflows/sdk.yml\nindex 3dca3c8b..f1169b2e 100644\n--- a/.github/workflows/sdk.yml\n+++ b/.github/workflows/sdk.yml\n@@ -32,6 +32,12 @@ jobs:\n         run: |\n           source scripts/env.sh\n           uv run --project .sdk python .sdk/tests/integration.py\n+      - name: Benchmark counter smoke and pinned workload builds\n+        shell: bash\n+        run: |\n+          scripts/rv32-bench run --benchmarks smoke --cycles 200000 --backend simulate --output build/kpi-ci-smoke\n+          scripts/rv32-bench fetch .sdk/vendor/embench\n+          scripts/rv32-bench run --backend build --output build/kpi-ci-embench\n       - name: Diagnostic logs\n         if: failure()\n         uses: actions/upload-artifact@v4\ndiff --git a/.gitignore b/.gitignore\nindex f091677d..f8e9355d 100644\n--- a/.gitignore\n+++ b/.gitignore\n@@ -52,3 +52,6 @@ src/*/*/quartus/*.smsg\n .sdk/platforms/\n .sdk/.platform-*/\n .sdk/.views.lock\n+\n+# Downloaded benchmark sources (pinned by the local benchmark runner)\n+.sdk/vendor/\ndiff --git a/.sdk/pyproject.toml b/.sdk/pyproject.toml\nindex 5df660b6..279ee3e6 100644\n--- a/.sdk/pyproject.toml\n+++ b/.sdk/pyproject.toml\n@@ -20,7 +20,7 @@ riscv-tools = {path = \"tools\", editable = true}\n [tool.ruff]\n target-version = \"py314\"\n line-length = 79\n-exclude = [\"tools\", \".venv\", \"platforms\"]\n+exclude = [\"tools\", \".venv\", \"platforms\", \"vendor\"]\n \n [tool.ruff.lint]\n select = [\"E\", \"F\", \"I\", \"UP\", \"B\"]\n@@ -30,7 +30,7 @@ ignore = [\"E501\"]\n dev = [\"ruff>=0.14\", \"deptry>=0.20\"]\n \n [tool.deptry]\n-exclude = [\"tools\", \".venv\", \"platforms\", \"tests\"]\n+exclude = [\"tools\", \".venv\", \"platforms\", \"tests\", \"vendor\"]\n \n [tool.deptry.per_rule_ignores]\n # Imported by the SDK's generated upstream cocotb testbench, not the CLI package.\ndiff --git a/SDK.md b/SDK.md\nindex 1cad2fa3..a26f6325 100644\n--- a/SDK.md\n+++ b/SDK.md\n@@ -95,3 +95,9 @@ SDK CI covers its separate Python project and actual C/GHDL execution. The\n processor CI retains its own checks. Hardware acceptance additionally requires\n Program FPGA, Fast Update, long stdout, and C/Rust mode switching on an available\n board; simulation is not a substitute for those tests.\n+\n+## Local KPI benchmark development\n+\n+The initial counter harness and pinned Embench workload runner are documented in\n+[the benchmark guide](.sdk/benchmarks/README.md). It exports raw measurements and\n+provenance; it does not yet produce an official Embench suite score.\ndiff --git a/scripts/kpi_report.py b/scripts/kpi_report.py\nindex 6b181111..e81287ff 100644\n--- a/scripts/kpi_report.py\n+++ b/scripts/kpi_report.py\n@@ -27,7 +27,9 @@ RESOURCE_PATTERNS = {\n         r\"Logic utilization \\(in ALMs\\)\\s*;\\s*([\\d,]+)\\s*/\\s*([\\d,]+)\"\n     ),\n     \"registers\": r\"Total registers\\s*;\\s*([\\d,]+)\",\n-    \"m9k_blocks\": r\"Total block memory bits\\s*;\\s*([\\d,]+)\\s*/\\s*([\\d,]+)\",\n+    \"block_memory_bits\": (\n+        r\"Total block memory bits\\s*;\\s*([\\d,]+)\\s*/\\s*([\\d,]+)\"\n+    ),\n     \"dsp_blocks\": r\"DSP block 18-bit elements\\s*;\\s*([\\d,]+)\\s*/\\s*([\\d,]+)\",\n     \"plls\": r\"PLLs\\s*;\\s*([\\d,]+)\\s*/\\s*([\\d,]+)\",\n }\n@@ -63,19 +65,19 @@ def parse_pll_clock(quartus_dir: Path) -> Json:\n     \"\"\"L\u00ea a frequ\u00eancia configurada no PLL da CPU no pll_0002.v.\"\"\"\n     pll_file = _find_pll_file(quartus_dir)\n     if pll_file is None:\n-        return {\"error\": \"pll_0002.v nao encontrado\", \"fmax_mhz\": None}\n+        return {\"error\": \"pll_0002.v nao encontrado\", \"configured_mhz\": None}\n     text = pll_file.read_text(encoding=\"utf-8\", errors=\"replace\")\n     match = re.search(r'output_clock_frequency0\\(\"([\\d.]+)\\s*MHz\"\\)', text)\n     if match:\n         return {\n             \"source\": str(pll_file),\n             \"clock_name\": \"PLL output0 (CPU clock)\",\n-            \"fmax_mhz\": float(match.group(1)),\n+            \"configured_mhz\": float(match.group(1)),\n             \"note\": \"Frequencia configurada no PLL (pll_0002.v)\",\n         }\n     return {\n         \"error\": \"Padrao de frequencia nao encontrado em pll_0002.v\",\n-        \"fmax_mhz\": None,\n+        \"configured_mhz\": None,\n     }\n \n \n@@ -91,7 +93,7 @@ def parse_fmax(report_path: Path) -> Json:\n         return result\n     text = report_path.read_text(encoding=\"utf-8\", errors=\"replace\")\n     pattern = re.compile(\n-        r\";\\s*([\\d.]+)\\s*MHz\\s*;[^;]*;\\s*([\\w\\[\\].]+)\\s*;\", re.IGNORECASE\n+        r\";\\s*([\\d.]+)\\s*MHz\\s*;[^;]*;\\s*([^;\\n]+)\\s*;\", re.IGNORECASE\n     )\n     matches = pattern.findall(text)\n     if not matches:\n@@ -103,7 +105,10 @@ def parse_fmax(report_path: Path) -> Json:\n     worst = min(cpu or parsed, key=lambda x: x[1])\n     result[\"clock_name\"] = worst[0]\n     result[\"fmax_mhz\"] = worst[1]\n-    result[\"all_clocks\"] = dict(parsed)\n+    result[\"all_clocks\"] = {\n+        name: min(value for clock, value in parsed if clock == name)\n+        for name, _ in parsed\n+    }\n     return result\n \n \n@@ -306,14 +311,14 @@ def build_report(args: argparse.Namespace) -> Json:\n     \"\"\"Monta o relat\u00f3rio com os tr\u00eas KPIs.\"\"\"\n     quartus_dir = Path(args.quartus_dir)\n     pll = parse_pll_clock(quartus_dir)\n-    clock = (\n-        pll if pll.get(\"fmax_mhz\") else parse_fmax(quartus_dir / args.sta_rpt)\n-    )\n+    clock = parse_fmax(quartus_dir / args.sta_rpt)\n     return {\n+        \"schema_version\": 2,\n         \"generated_at\": datetime.now().isoformat(timespec=\"seconds\"),\n         \"project\": \"RV32IM, Capstone Insper/CTI 2026.1\",\n         \"kpis\": {\n             \"kpi1_clock_mhz\": clock,\n+            \"kpi1_configured_clock\": pll,\n             \"kpi1_resources\": parse_resource_utilization(\n                 quartus_dir / args.fit_rpt\n             ),\n@@ -385,7 +390,7 @@ def _parse_args() -> argparse.Namespace:\n         formatter_class=argparse.ArgumentDefaultsHelpFormatter,\n     )\n     parser.add_argument(\n-        \"--quartus-dir\", default=\"TopLevel/platforms/internal-mem/quartus\"\n+        \"--quartus-dir\", default=\"src/simulation/internal-mem/quartus\"\n     )\n     parser.add_argument(\n         \"--sta-rpt\", default=\"output_files/core_fpga_test.sta.rpt\"",
