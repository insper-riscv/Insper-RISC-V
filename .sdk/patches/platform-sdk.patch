+def export_stdout(bus: RamBus, uart_bytes: bytes | None = None) -> None:
+    """Export exact program bytes for the SDK's quiet terminal."""
+    target = os.environ.get("RV32_SIM_STDOUT_FILE")
+    if not target:
+        return
+    truncated = Path(str(target) + ".truncated")
+    truncated.unlink(missing_ok=True)
+    if uart_bytes is None and bus.serial_bytes:
+        uart_bytes = bytes(bus.serial_bytes)
+    if uart_bytes is None:
+        base = int(os.environ["STDOUT_ADDR"], 0) - RAM_BASE
+        size = sum(bus.ram_bytes.get(base + i, 0) << (8 * i) for i in range(4))
+        if bus.ram_bytes.get(base + 4, 0):
+            truncated.write_text("1")
+        uart_bytes = bytes(
+            bus.ram_bytes.get(base + 8 + i, 0)
+            for i in range(
+                min(size, int(os.environ.get("RV32_STDOUT_CAPACITY", "1024")))
+            )
+        )
+    Path(target).write_bytes(uart_bytes)
 
 
